# Example settings for wiscoddns (copy to .env for `docker run --env-file .env`; .env is git-ignored).
# The token is NOT set here: it is read from a file (WISCODDNS_TOKEN_FILE), mounted read-only.

# Required: the record to keep updated and its zone
WISCODDNS_RECORD=ddns.example.org
WISCODDNS_ZONE=example.org

# Optional (defaults shown)
# WISCODDNS_TOKEN_FILE=/run/secrets/cloudflare_token
# WISCODDNS_INTERVAL=300
# WISCODDNS_DRY_RUN=0
# WISCODDNS_FAIL_ALERT_AFTER=3

# Optional ntfy notifications (off while WISCODDNS_NTFY_URL is empty)
# WISCODDNS_NTFY_URL=https://ntfy.example.org
# WISCODDNS_NTFY_TOPIC=alerts
# WISCODDNS_NTFY_TOKEN_FILE=/run/secrets/ntfy_token
